{
  "name": "@civ-clone/base-difficulty",
  "version": "0.1.0",
  "description": "What a ruleset's difficulty rules share: whether a person plays a player, the game's level, and computer players' scaled build costs.",
  "repository": "git@github.com:civ-clone/base-difficulty.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-ai-client": "^0.1.3",
    "@civ-clone/core-city": "^0.1.20",
    "@civ-clone/core-city-build": "^0.1.14",
    "@civ-clone/core-client": "^0.1.4",
    "@civ-clone/core-difficulty": "^0.1.0",
    "@civ-clone/core-player": "^0.1.10"
  }
